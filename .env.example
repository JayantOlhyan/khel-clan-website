# ==============================================================================
# KhelClan Website - Client-Side Environment Variables Template (.env.example)
# ==============================================================================
# IMPORTANT:
# - All variables exposed to the Vite frontend must be prefixed with VITE_.
# - ONLY client-safe, public keys belong here. NEVER place private credentials,
#   Razorpay secret keys, Firebase service account keys, or admin tokens in client code.
# - Copy this file to .env.local for local development.
# ==============================================================================

# Firebase Web Client Configuration (Required for W1+ Auth & Functions)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=khelclan-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=khelclan-prod
VITE_FIREBASE_STORAGE_BUCKET=khelclan-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Firebase Emulators (Optional: set to "true" to connect to local emulator suite)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=http://localhost:5001

# Public Razorpay Key ID (Client-side checkout only - NEVER add RAZORPAY_KEY_SECRET here!)
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id_here

# App Store & Deep Linking URLs
VITE_APP_STORE_URL=https://apps.apple.com/app/id000000000
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.khelclan.app
VITE_SITE_URL=https://khelclan.com
